OPENAI_API_KEY=내_API_키
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
NOIE_DEV_USER_NAME=dev-user
NOIE_DEV_CONVERSATION_TITLE=NOIE 개발 대화
# 선택 사항: 지정하면 이름 검색/bootstrap보다 UUID를 우선 사용합니다.
# NOIE_DEV_USER_ID=00000000-0000-0000-0000-000000000000
# NOIE_DEV_CONVERSATION_ID=00000000-0000-0000-0000-000000000000
NOIE_MEMORY_PROCESSING_TIMEOUT_SECONDS=300
NOIE_MEMORY_MAX_EXTRACTION_ATTEMPTS=3
